<?xml version="1.0" encoding="UTF-8"?>
<office:document-content
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    office:version="1.1">
  <office:body>
    <office:spreadsheet>
      <table:table table:name="Sheet1">
        <table:table-row>
          <table:table-cell/>
        </table:table-row>
      </table:table>
      <table:named-expressions>
        <table:named-range table:name="Range1" table:base-cell-address="$Sheet1.$A$1" table:cell-range-address="$Sheet1.$A$1:$A$10"/>
      </table:named-expressions>
    </office:spreadsheet>
  </office:body>
</office:document-content>
