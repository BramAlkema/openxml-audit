<?xml version="1.0" encoding="UTF-8"?>
<office:document-content xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" office:version="1.3">
  <office:automatic-styles>
    <style:style style:name="ConditionalPara" style:family="paragraph">
      <style:map style:condition="page-number() = 1" style:apply-style-name="NonExistentStyle"/>
    </style:style>
  </office:automatic-styles>
  <office:body><office:text><text:p text:style-name="ConditionalPara">Hello</text:p></office:text></office:body>
</office:document-content>
